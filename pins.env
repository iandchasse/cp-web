# Upstream versions this build is known to work against.
# Bump deliberately: a firmware bump usually needs new HAL stubs in the
# simulator, and the build will fail to LINK (not compile) when one is missing.
EMSDK_VERSION=6.0.4
FIRMWARE_REPO=https://github.com/crosspoint-reader/crosspoint-reader
FIRMWARE_REF=8bc1603
SIMULATOR_REPO=https://github.com/crosspoint-reader/crosspoint-simulator
SIMULATOR_REF=8323320

# Single-header ArduinoJson amalgamation, fetched into thirdparty/. The
# firmware and the simulator's WString.h both expect this exact major version.
# The sha256 is the release asset's published digest; the fetch verifies it.
ARDUINOJSON_VERSION=7.4.2
ARDUINOJSON_SHA256=a05ac98f4481d2398c103ca5ffcce8e2fcd7fa2fa1d8d9f38d5757454f448d97

# Release tag on THIS repo holding fs-content.tar.zst (the ~134 MB SD card
# tree: books, fonts, dictionaries). Kept out of git deliberately.
FS_CONTENT_TAG=fs-content-v1
