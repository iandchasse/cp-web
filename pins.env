# Upstream versions this build is known to work against.
# Bump deliberately: a firmware bump usually needs new HAL stubs in the
# simulator, and the build will fail to LINK (not compile) when one is missing.
EMSDK_VERSION=6.0.9

# Each firmware variant pins its own firmware and simulator pair; they are
# separate upstream projects, and each has its own web patch in patches/.
# Keys are <VARIANT>_FIRMWARE_* / <VARIANT>_SIMULATOR_*, matching VARIANTS in
# build.py. Pin tags where upstream publishes them, expanded to full SHAs.

# CrossPoint 1.6.5rc. The simulator is at its own HEAD, which is still behind
# this firmware's HAL: patches/simulator-web.patch carries three catch-up shims
# (see its header) to delete once upstream grows them.
CROSSPOINT_FIRMWARE_REPO=https://github.com/crosspoint-reader/crosspoint-reader
CROSSPOINT_FIRMWARE_REF=a1ceb6333f907856e4dcde21bd0a94f5be84452b
CROSSPOINT_SIMULATOR_REPO=https://github.com/crosspoint-reader/crosspoint-simulator
CROSSPOINT_SIMULATOR_REF=047527f0db530d70c04253ccda326a46e11b691e

# CrossInk v1.5.1, a fork of CrossPoint 1.5 with its own simulator.
CROSSINK_FIRMWARE_REPO=https://github.com/uxjulia/CrossInk
CROSSINK_FIRMWARE_REF=4f2da6b7777b9a38fdf2606796d6da34caa7d2cb
CROSSINK_SIMULATOR_REPO=https://github.com/uxjulia/crossink-simulator
CROSSINK_SIMULATOR_REF=95be4c2e546d6e88625fb33c31478893d4f06f1b

# Single-header ArduinoJson amalgamation, fetched into thirdparty/. The
# firmware and the simulator's WString.h both expect this exact major version.
# The sha256 is the release asset's published digest; the fetch verifies it.
ARDUINOJSON_VERSION=7.4.3
ARDUINOJSON_SHA256=ab5fbb8268b846b5f4bc5a5fee11bb2c96f7b8b846f5bef6540afb6a9cc76a5b

# Release tag on THIS repo holding fs-content.tar.zst (the ~62 MB SD card
# tree: books, fonts, dictionaries). Kept out of git deliberately.
FS_CONTENT_TAG=fs-content-v2
