+#ifdef __EMSCRIPTEN__
+// How long the firmware has asked the main thread to pause for, as an absolute
+// millis() deadline. Read by the web main loop (shims/web_main.cpp), which
+// simply runs no firmware work until it passes.
+inline unsigned long &cpwebDelayDeadline() {
+  static unsigned long deadline = 0;
+  return deadline;
+}
+#endif
+
 inline void delay(unsigned long ms) {
+#ifdef __EMSCRIPTEN__
+  // A browser main thread cannot sleep: Emscripten spins instead, and that
+  // thread is the only one that can service requestAnimationFrame, input and
+  // WebGL. loop() ends with delay(10), or delay(50) once idle, so honouring it
+  // literally burned 10-50 ms of every animation frame -- visible as a capped
+  // frame rate while orbiting the 3D view. Record the deadline and return; the
+  // frame loop skips firmware work until it expires, which keeps the firmware's
+  // own pacing without blocking the page. Worker threads still really sleep.
+  if (emscripten_is_main_browser_thread()) {
+    unsigned long &deadline = cpwebDelayDeadline();
+    const unsigned long until = millis() + ms;
+    if (until > deadline) deadline = until;
+    return;
+  }
+#endif
   std::this_thread::sleep_for(std::chrono::milliseconds(ms));
 }
 inline void yield() { std::this_thread::yield(); }
