+
+#ifdef __EMSCRIPTEN__
+bool HalGPIO::isWebSleepActive() const { return webSleepActive; }
+
+bool HalGPIO::pollWebSleepWake() {
+  SDL_Event e;
+  while (SDL_PollEvent(&e) != 0) {
+    if (e.type == SDL_QUIT) {
+      quitRequested.store(true);
+      return false;
+    }
+    // Only the power button wakes; every other key/touch is ignored so sleep is
+    // unresponsive like the hardware. Ignore auto-repeat so the same hold that
+    // triggered sleep can't immediately re-wake.
+    if (e.type == SDL_KEYDOWN && !e.key.repeat &&
+        e.key.keysym.scancode == buttonScancode[BTN_POWER]) {
+      clearButtonState();
+      webSleepActive = false;
+      return true;
+    }
+  }
+  return false;
 }
+#endif
+
 bool HalGPIO::verifyPowerButtonWakeup() { return true; }
 
