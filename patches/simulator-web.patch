+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+// ---------------------------------------------------------------------------
+// Live panel tap for the web build's 3D device view.
+//
+// The 3D view needs the panel as a WebGL texture. Reading it back off the SDL
+// canvas would mean preserveDrawingBuffer + a GPU->CPU->GPU round trip, which
+// is both slow and timing-fragile. Instead we expose the ARGB buffer the
+// renderer already maintains for SDL_UpdateTexture, and let JS upload it
+// directly as a DataTexture.
+//
+// cp_fb_sync() copies pixelBuf into a snapshot under pixelBufMutex and returns
+// the frame counter. JS compares that against the last value it uploaded and
+// skips the texture upload when nothing changed -- e-ink refreshes a few times
+// a second, not 60, so the steady-state cost here is nil.
+//
+// The snapshot copy is required, not defensive: JS must not hold a view into
+// pixelBuf while the render worker is writing it, and in a pthreads build
+// HEAPU8.buffer is a SharedArrayBuffer, which some browsers reject as a
+// texImage2D source. Copying once here solves both.
+//
+// ORIENTATION: pixelBuf is always the *physical* landscape panel. The firmware
+// rotates content into it, and presentIfNeeded() undoes that rotation so the
+// SDL window is upright -- correct for a monitor you cannot tilt. A 3D view
+// showing the real device must NOT undo it that way: there the panel sits
+// behind portrait glass, so buffer -> glass is a fixed transform and landscape
+// content is meant to look sideways. cp_fb_orientation() is exported for
+// callers that want the setting (HUDs, debug), not as a rotation to apply.
+// ---------------------------------------------------------------------------
+static uint32_t
+    fbSnapshot[HalDisplay::DISPLAY_WIDTH * HalDisplay::DISPLAY_HEIGHT];
+
+// Declared outside the extern "C" block below: inside it this would pick up C
+// linkage and clash with the C++ definition in the firmware's main.cpp.
+extern GfxRenderer renderer;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int cp_fb_width() { return HalDisplay::DISPLAY_WIDTH; }
+EMSCRIPTEN_KEEPALIVE int cp_fb_height() { return HalDisplay::DISPLAY_HEIGHT; }
+
+EMSCRIPTEN_KEEPALIVE uintptr_t cp_fb_ptr() {
+  return reinterpret_cast<uintptr_t>(fbSnapshot);
+}
+
+// Copy the current panel into the snapshot buffer; returns the frame counter.
+EMSCRIPTEN_KEEPALIVE uint32_t cp_fb_sync() {
+  const std::lock_guard<std::mutex> lock(pixelBufMutex);
+  memcpy(fbSnapshot, pixelBuf, sizeof(fbSnapshot));
+  return pixelBufFrame.load();
+}
+
+// Cheap poll so JS can skip the copy entirely when the panel is unchanged.
+EMSCRIPTEN_KEEPALIVE uint32_t cp_fb_counter() { return pixelBufFrame.load(); }
+
+// 0=Portrait 1=LandscapeClockwise 2=PortraitInverted 3=LandscapeCCW
+EMSCRIPTEN_KEEPALIVE int cp_fb_orientation() {
+  return static_cast<int>(renderer.getOrientation());
+}
+}
+#endif // __EMSCRIPTEN__
